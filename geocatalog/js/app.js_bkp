let map;
let feicoesVisiveisGroup;
let dadosGeoJson;
let legendaControl = null;
let osmLayer, esriImageryLayer;

// Guarda as categorias ativas/selecionadas e valores únicos
let categoriasAtivas = new Set();
let valoresUnicosAtuais = [];

const cores = ['#e74c3c', '#3498db', '#2ecc71', '#f1c40f', '#9b59b6', '#1abc9c', '#e67e22', '#34495e', '#27ae60', '#2980b9', '#8e44ad', '#f39c12', '#d35400'];

const nomesAtributos = {
    'Projeto': 'Projeto',
    'Municipio': 'Município',
    'Platform': 'Plataforma',
    'Ano': 'Ano do Voo'
};

// Ocultar/Exibir Barra Lateral
function toggleSidebar() {
    const sidebar = document.getElementById('sidebar');
    const btn = document.getElementById('toggle-btn');
    sidebar.classList.toggle('collapsed');
    btn.innerText = sidebar.classList.contains('collapsed') ? '▶' : '◀';
    setTimeout(() => { map.invalidateSize(); }, 300);
}

// Alternar mapa de fundo
function mudarMapaDeFundo() {
    const tipo = document.getElementById('basemapSelect').value;
    if (tipo === 'esri') {
        map.removeLayer(osmLayer);
        esriImageryLayer.addTo(map);
    } else {
        map.removeLayer(esriImageryLayer);
        osmLayer.addTo(map);
    }
}

function extrairMunicipio(missionStr) {
    if (!missionStr || missionStr === 'Não informado') return 'Desconhecido';
    const partes = missionStr.split('_');
    return partes[0] || 'Desconhecido';
}

function extrairAno(datetimeStr) {
    if (!datetimeStr || datetimeStr === 'Não informado') return 'Ignorado';
    return datetimeStr.substring(0, 4);
}

function obterValorAtributo(properties, attr) {
    if (attr === 'Municipio') return properties.Municipio || extrairMunicipio(properties.Mission);
    if (attr === 'Ano') return extrairAno(properties.Datetime);
    return properties[attr] || 'Não informado';
}

function obterCor(valor) {
    const index = valoresUnicosAtuais.indexOf(valor);
    return cores[index % cores.length] || '#95a5a6';
}

// Criar conteúdo do Popup
function criarConteudoPopup(properties) {
    const datetime = properties.Datetime || '';
    const dataFormatada = datetime.length >= 10 ? datetime.substring(0, 10) : 'N/A';
    const nomeVoo = properties.Nome_Voo || 'N/A';
    const projeto = properties.Projeto || 'Não informado';
    const nota = properties.Nota || 'N/A';
    const municipio = properties.Municipio || extrairMunicipio(properties.Mission);
    const plataforma = properties.Platform || 'N/A';

    return `
        <div style="font-size: 13px; line-height: 1.5; min-width: 180px;">
            <strong style="font-size: 14px; color: #2c3e50;">Voo: ${nomeVoo}</strong><br>
            <b>Projeto:</b> ${projeto}<br>
            <b>Município:</b> ${municipio}<br>
            <b>Plataforma:</b> ${plataforma}<br>
            <b>Data:</b> ${dataFormatada}<br>
            <b>Nota:</b> ${nota}
        </div>
    `;
}

// Inicialização do Mapa
function inicializarMapa() {
    map = L.map('map').setView([-15.7801, -47.9292], 4);

    osmLayer = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '&copy; OpenStreetMap contributors'
    });

    esriImageryLayer = L.tileLayer('https://arcgisonline.com{z}/{y}/{x}', {
        maxZoom: 19,
        attribution: 'Tiles &copy; Esri &mdash; Source: Esri, i-cubed, USDA, USGS, AEX, GeoEye, Getmapping, Aerogrid, IGN, IGP, UPR-EGP, and the GIS User Community'
    });

    osmLayer.addTo(map);
    feicoesVisiveisGroup = L.geoId = L.geoJson(null).addTo(map);

    // Carrega o arquivo GeoJSON da pasta data automaticamente
    carregarDadosGeoJson();
}

// Função para buscar o arquivo GeoJSON na pasta data/
function carregarDadosGeoJson() {
    fetch('data/voos_labdrones.geojson')
        .then(response => {
            if (!response.ok) {
                throw new Error('Não foi possível carregar o arquivo geojson de dados.');
            }
            return response.json();
        })
        .then(data => {
            dadosGeoJson = data;
            // Executa a primeira renderização dos filtros e feições
            trocarAtributoFiltro();
        })
        .catch(error => {
            console.error('Erro ao ler a pasta data:', error);
        });
}

// Funções stub para evitar erros de inicialização dos seletores HTML
function trocarAtributoFiltro() {
    if (!dadosGeoJson) return;
    const atributoAtivo = document.getElementById('filterAttribute').value;
    
    // Extrai valores únicos do atributo selecionado
    const valoresset = new Set();
    dadosGeoJson.features.forEach(f => {
        valoresset.add(obterValorAtributo(f.properties, atributoAtivo));
    });
    valoresUnicosAtuais = Array.from(valoresset).sort();
    categoriasAtivas = new Set(valoresUnicosAtuais);

    renderizarCamadasFiltro();
    atualizarLegenda(atributoAtivo);
}

function renderizarCamadasFiltro() {
    feicoesVisiveisGroup.clearLayers();
    const atributoAtivo = document.getElementById('filterAttribute').value;

    const camadaFiltrada = L.geoJson(dadosGeoJson, {
        filter: function(feature) {
            const valor = obterValorAtributo(feature.properties, atributoAtivo);
            return categoriasAtivas.has(valor);
        },
        pointToLayer: function(feature, latlng) {
            const valor = obterValorAtributo(feature.properties, atributoAtivo);
            return L.circleMarker(latlng, {
                radius: 8,
                fillColor: obterCor(valor),
                color: "#fff",
                weight: 1,
                opacity: 1,
                fillOpacity: 0.8
            });
        },
        onEachFeature: function(feature, layer) {
            layer.bindPopup(criarConteudoPopup(feature.properties));
        }
    });

    feicoesVisiveisGroup.addLayer(camadaFiltrada);
    if (feicoesVisiveisGroup.getLayers().length > 0) {
        map.fitBounds(feicoesVisiveisGroup.getBounds());
    }
}

function atualizarLegenda(atributo) {
    if (legendaControl) {
        map.removeControl(legendaControl);
    }

    legendaControl = L.control({ position: 'bottomright' });
    legendaControl.onAdd = function() {
        const div = L.DomUtil.create('div', 'legend');
        div.innerHTML = `<b>${nomesAtributos[atributo]}</b><br>`;
        
        valoresUnicosAtuais.forEach(valor => {
            const desativadoClass = categoriasAtivas.has(valor) ? '' : 'desativado';
            div.innerHTML += `
                <div class="legend-item ${desativadoClass}" onclick="alternarCategoriaLegenda('${valor}')">
                    <span class="legend-color-box" style="background: ${obterCor(valor)}"></span>
                    <span>${valor}</span>
                </div>
            `;
        });
        return div;
    };
    legendaControl.addTo(map);
}

function alternarCategoriaLegenda(valor) {
    if (categoriasAtivas.has(valor)) {
        categoriasAtivas.delete(valor);
    } else {
        categoriasAtivas.add(valor);
    }
    renderizarCamadasFiltro();
    const atributoAtivo = document.getElementById('filterAttribute').value;
    atualizarLegenda(atributoAtivo);
}

function exportarGeoJsonParaCSV() {
    if (!dadosGeoJson) return;
    let csvContent = "data:text/csv;charset=utf-8,";
    csvContent += "Nome_Voo,Projeto,Municipio,Platform,Datetime,Nota\n";

    dadosGeoJson.features.forEach(f => {
        const p = f.properties;
        const muni = p.Municipio || extrairMunicipio(p.Mission);
        const linha = `"${p.Nome_Voo || ''}","${p.Projeto || ''}","${muni}","${p.Platform || ''}","${p.Datetime || ''}","${p.Nota || ''}"\n`;
        csvContent += linha;
    });

    const encodedUri = encodeURI(csvContent);
    const link = document.createElement("a");
    link.setAttribute("href", encodedUri);
    link.setAttribute("download", "info_voos_labdrones.csv");
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
}

// Inicia o mapa assim que a janela carregar
window.onload = inicializarMapa;
